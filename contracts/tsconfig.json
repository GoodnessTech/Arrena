{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": [
      "node",
      "mocha"
    ]
  },
  "include": [
    "./scripts/**/*",
    "./test/**/*",
    "hardhat.config.js"
  ],
  "exclude": [
    "node_modules",
    "artifacts",
    "cache"
  ]
}
