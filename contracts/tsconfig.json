{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"]
  },
  "include": [
    "hardhat.config.js",
    "scripts/**/*",
    "test/**/*"
  ],
  "exclude": [
    "node_modules",
    "artifacts",
    "cache"
  ]
}
